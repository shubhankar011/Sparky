    "TURN_LEFT": {
      "description": "Turn the robot left.",
      "category": "movement",
      "parameters": {},
      "examples": [
        "turn left",
        "go left",
        "move left"
      ]
    },

    "TURN_RIGHT": {
      "description": "Turn the robot right.",
      "category": "movement",
      "parameters": {},
      "examples": [
        "turn right",
        "go right",
        "move right"
      ]
    },

    "STOP": {
      "description": "Stop all robot movement.",
      "category": "movement",
      "parameters": {},
      "examples": [
        "stop",
        "stop moving",
        "halt",
        "don't move",
        "freeze"
      ]
    },

    "GET_TEMPERATURE": {
      "description": "Read the current temperature from an available temperature sensor.",
      "category": "sensors",
      "parameters": {},
      "examples": [
        "what is the temperature",
        "tell me the temperature",
        "how hot is it",
        "check the temperature"
      ]
    },

    "CHECK_DISTANCE": {
      "description": "Measure the distance to an object using the distance sensor.",
      "category": "sensors",
      "parameters": {},
      "examples": [
        "how far is the object",
        "check the distance",
        "measure the distance",
        "how close is that"
      ]
    },

    "CHECK_LIGHT": {
      "description": "Check the current ambient light level using the light sensor.",
      "category": "sensors",
      "parameters": {},
      "examples": [
        "is it dark",
        "check the light level",
        "how bright is it",
        "is there enough light"
      ]
    },

    "SAY": {
      "description": "Speak a response to the user.",
      "category": "communication",
      "parameters": {
        "text": {
          "type": "string",
          "required": true,
          "description": "The text Sparky should say."
        }
      },
      "examples": [
        "say hello",
        "tell me something",
        "say that again"
      ]
    },

    "UNKNOWN": {
      "description": "The command does not match any supported Sparky command.",
      "category": "system",
      "parameters": {},
      "examples": []
    }
  }
}
